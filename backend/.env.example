# Server
PORT=5000
NODE_ENV=development

# HERO SMS API
HERO_SMS_BASE_URL=https://hero-sms.com
HERO_SMS_API_KEY=YOUR_API_KEY
HERO_SMS_ACCOUNT_ID=YOUR_ACCOUNT_ID
HERO_SMS_EMAIL=your@email.com
HERO_SMS_USERNAME=your_username
HERO_SMS_PASSWORD=your_password

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=smsverify-kh

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
