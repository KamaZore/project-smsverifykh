{
  "info": {
    "_postman_id": "f2c9a1b3-91d4-4e7b-8a1f-7d5c0f3e2b9a",
    "name": "SMSVerifyKh - HERO SMS API Tests",
    "description": "Postman collection to test all routes of the SMSVerifyKh backend (HERO SMS integration).\n\nBefore testing:\n1. Make sure the backend is running: cd backend  =>  npm run dev\n2. Put your real HERO SMS API key in backend/.env => HERO_SMS_API_KEY=your_key\n3. Base URL default: http://localhost:5000 (edit the {{base_url}} variable if your port changed)\n\nIf a response shows success:false, check that HERO_SMS_API_KEY is valid and that the service/country ids exist on hero-sms.com.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "service", "value": "tg" },
    { "key": "country", "value": "6" },
    { "key": "activation_id", "value": "1" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Attach Bearer token automatically to protected routes",
          "const url = pm.request.url.toString();",
          "const isPublic = url.includes('/health') || url.includes('/api/auth/register') || url.includes('/api/auth/login') || url.includes('/api/auth/refresh');",
          "if (!isPublic) {",
          "  const token = pm.collectionVariables.get('access_token');",
          "  if (token) pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    }
  ],
  "item": [
{
      "name": "0. Auth (JWT)",
      "item": [
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demouser\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"Secret123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Create an account. The accessToken/refreshToken are saved automatically into the collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "const d = pm.response.json();",
                  "if (d.success && d.data && d.data.accessToken) {",
                  "  pm.collectionVariables.set('access_token', d.data.accessToken);",
                  "  pm.collectionVariables.set('refresh_token', d.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
